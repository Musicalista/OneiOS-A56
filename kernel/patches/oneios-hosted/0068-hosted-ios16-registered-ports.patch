+#if XNU_HOSTED
+/* The 16.5 Mach user ABI carries the registered ports in one OOL descriptor. */
+kern_return_t
+mach_ports_register(task_t task, mach_port_array_t ports, mach_msg_type_number_t count)
+{
+	if (task != current_task() || count > TASK_PORT_REGISTER_MAX || (!ports && count)) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	ipc_port_t names[TASK_PORT_REGISTER_MAX] = { 0 };
+	for (mach_msg_type_number_t i = 0; i < count; i++) {
+		names[i] = ports[i].port;
+	}
+	kern_return_t kr = _kernelrpc_mach_ports_register3(task, names[0], names[1], names[2]);
+	if (kr == KERN_SUCCESS && ports) {
+		mach_port_array_free(ports, count);
+	}
+	return kr;
+}
+
+kern_return_t
+mach_ports_lookup(task_t task, mach_port_array_t *ports, mach_msg_type_number_t *count)
+{
+	if (task != current_task()) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	mach_port_array_t result = mach_port_array_alloc(TASK_PORT_REGISTER_MAX, Z_WAITOK | Z_ZERO);
+	if (!result) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	ipc_port_t names[3]; kern_return_t kr = _kernelrpc_mach_ports_lookup3(task, &names[0], &names[1], &names[2]);
+	if (kr != KERN_SUCCESS) {
+		mach_port_array_free(result, TASK_PORT_REGISTER_MAX);
+		return kr;
+	}
+	for (unsigned i = 0; i < 3; i++) { result[i].port = names[i]; } *ports = result;
+	*count = TASK_PORT_REGISTER_MAX;
+	return KERN_SUCCESS;
+}
+#endif
